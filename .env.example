# ─── Core ─────────────────────────────────────────────────────
DJANGO_SECRET_KEY=generate-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=localhost,yourdomain.com

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ─── NextAuth ─────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32

# ─── Google Cloud PubSub ─────────────────────────────────────
# Path to your service account JSON key file
cred=/run/secrets/gcp-key.json
INPUT_TOPIC=projects/YOUR_PROJECT/topics/input-topic
MERCHANT_TOPIC=projects/YOUR_PROJECT/topics/merchant-topic
CONTENT_TOPIC=projects/YOUR_PROJECT/topics/content-topic
AGGREGATOR_TOPIC=projects/YOUR_PROJECT/topics/aggregator-topic

# ─── Groq API (LLM) ──────────────────────────────────────────
GROQ_API_KEY=gsk_your-groq-api-key

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=only-if-auth-enabled

# ─── Optional: Postgres ───────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/dbname
